{
  "name": "lolterm-desktop",
  "version": "0.5.2",
  "private": true,
  "type": "module",
  "description": "LoLTerm — multiplexor gráfico de terminales",
  "author": {
    "name": "LoLTerm",
    "email": "lolterm@users.noreply.github.com"
  },
  "homepage": "https://github.com/LautaroPiugh/lolterm",
  "main": "electron/main.mjs",
  "scripts": {
    "dev": "node electron/dev.mjs",
    "build": "vite build",
    "pack": "node electron/pack.mjs"
  },
  "build": {
    "appId": "app.lolterm.desktop",
    "productName": "LoLTerm",
    "directories": {
      "buildResources": "build",
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "build/icon.png",
      "!electron/dev.mjs",
      "!electron/pack.mjs",
      "!**/node_modules/**"
    ],
    "extraResources": [
      {
        "from": "sidecar",
        "to": ".",
        "filter": ["lolterm-core"]
      },
      {
        "from": "build/icon.png",
        "to": "icon.png"
      }
    ],
    "linux": {
      "target": ["AppImage", "deb"],
      "icon": "build/icons",
      "category": "Development",
      "executableName": "lolterm",
      "desktop": {
        "Name": "LoLTerm",
        "Comment": "Multiplexor gráfico de terminales",
        "StartupWMClass": "LoLTerm",
        "Icon": "lolterm"
      },
      "maintainer": "LoLTerm <lolterm@users.noreply.github.com>",
      "artifactName": "LoLTerm-${version}-linux-${arch}.${ext}"
    }
  },
  "dependencies": {
    "@iconify-json/vscode-icons": "^1.2.72",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/xterm": "^5.5.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.5.0",
    "electron": "^37.2.0",
    "electron-builder": "^26.15.3",
    "typescript": "^5.8.3",
    "vite": "^6.3.0"
  }
}
