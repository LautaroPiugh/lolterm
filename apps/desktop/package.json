{
  "name": "lolterm-desktop",
  "version": "0.13.4",
  "private": true,
  "packageManager": "pnpm@11.24.0",
  "type": "module",
  "description": "LoLTerm — multiplexor gráfico de terminales",
  "license": "MIT",
  "author": {
    "name": "LoLTerm",
    "email": "lolterm@users.noreply.github.com"
  },
  "homepage": "https://github.com/LautaroPiugh/lolterm",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LautaroPiugh/lolterm.git"
  },
  "bugs": {
    "url": "https://github.com/LautaroPiugh/lolterm/issues"
  },
  "desktopName": "lolterm.desktop",
  "main": "electron/main.mjs",
  "scripts": {
    "dev": "node electron/dev.mjs",
    "build": "vite build",
    "pack": "node electron/pack.mjs"
  },
  "build": {
    "appId": "app.lolterm.desktop",
    "productName": "LoLTerm",
    "directories": {
      "buildResources": "build",
      "output": "release"
    },
    "afterPack": "electron/after-pack.cjs",
    "files": [
      "dist/**/*",
      "electron/**/*",
      "build/icon.png",
      "!electron/dev.mjs",
      "!electron/pack.mjs",
      "!electron/**/*.test.mjs",
      "!**/node_modules/**"
    ],
    "extraResources": [
      {
        "from": "sidecar",
        "to": ".",
        "filter": [
          "lolterm-core"
        ]
      },
      {
        "from": "build/icon.png",
        "to": "icon.png"
      }
    ],
    "linux": {
      "target": [
        "deb",
        "rpm"
      ],
      "icon": "build/icons",
      "category": "Development",
      "executableName": "lolterm",
      "syncDesktopName": true,
      "desktop": {
        "entry": {
          "Name": "LoLTerm",
          "Comment": "Multiplexor gráfico de terminales",
          "StartupWMClass": "LoLTerm",
          "Icon": "lolterm"
        }
      },
      "maintainer": "LoLTerm <lolterm@users.noreply.github.com>",
      "artifactName": "LoLTerm-${version}-linux-${arch}.${ext}"
    },
    "deb": {
      "fpm": [
        "--deb-user",
        "root",
        "--deb-group",
        "root",
        "build/metainfo/lolterm.metainfo.xml=/usr/share/metainfo/lolterm.metainfo.xml"
      ]
    },
    "rpm": {
      "fpm": [
        "--rpm-os",
        "linux",
        "build/metainfo/lolterm.metainfo.xml=/usr/share/metainfo/lolterm.metainfo.xml"
      ]
    }
  },
  "dependencies": {
    "@codemirror/language": "^6.12.4",
    "@codemirror/language-data": "^6.5.2",
    "@codemirror/state": "^6.7.1",
    "@codemirror/view": "^6.43.9",
    "@uiw/react-codemirror": "^4.25.11",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/xterm": "^5.5.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.5.0",
    "electron": "^37.2.0",
    "electron-builder": "^26.15.3",
    "typescript": "^5.8.3",
    "vite": "^6.3.0"
  }
}
